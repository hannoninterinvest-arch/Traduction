PORT=3001
NODE_ENV=development
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# memory runs with no cloud account.
# postgres (or neon) uses DATABASE_URL and stores files in the documents table.
# supabase uses the tables in supabase/migrations and Supabase Storage.
DATA_DRIVER=memory
DATABASE_URL=
AUTH_MODE=dev
TOKEN_SECRET=replace-with-a-long-random-string

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

OCR_PROVIDER=mock
OCR_FALLBACK_PROVIDER=
TRANSLATION_PROVIDER=mock
TRANSLATION_FALLBACK_PROVIDER=
PDF_RENDERER=client
PREPROCESS_IMAGES=false

MAX_UPLOAD_BYTES=15728640
MAX_PAGES=20
MONTHLY_PAGE_QUOTA=100
RETENTION_HOURS=24
SWAGGER_ENABLED=true

OCR_SPACE_API_KEY=
GOOGLE_API_KEY=
DEEPL_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

ANCHOR_ENABLED=false
ANCHOR_RPC_URL=
ANCHOR_PRIVATE_KEY=
ANCHOR_CHAIN=amoy
