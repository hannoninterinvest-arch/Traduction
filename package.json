{
  "name": "doctranslate",
  "private": true,
  "version": "0.1.0",
  "description": "Scan a document, translate it, and download a PDF that keeps the original layout.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @doctranslate/shared build && pnpm -r --parallel --filter @doctranslate/api --filter @doctranslate/web dev",
    "build": "pnpm --filter @doctranslate/shared build && pnpm --filter @doctranslate/api build && pnpm --filter @doctranslate/web build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @doctranslate/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
